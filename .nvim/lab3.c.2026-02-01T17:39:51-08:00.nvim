#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <string.h>
int main() {
  char *history[5] = {NULL};
  int index = 0;
  while (1) {
    printf("Enter input: ");
    char *buff = NULL;
    size_t size = 0;
    ssize_t num_char = getline(&buff, &size, stdin);
    if (num_char != -1) {
      history[index] = buff;
      index = (index + 1) % 5;
      if (strcmp(buff, "print\n") == 0) {
        while (history[index] == NULL) {
          index = (index + 1) % 5;
        }
        for (int i = 0; history[index] != NULL && i < 5; i++) {
          printf("%s", history[index]);
          history[index] = NULL;
          index = (index + 1) % 5;
        }
      }
    }
  }
  return 0;
}
